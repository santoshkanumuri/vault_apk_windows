{
  "manifest_version": 3,
  "name": "Nuvori Password Fill",
  "version": "0.7.2",
  "key": "",
  "description": "Fill and save logins from Nuvori for Windows, right on the page.",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "fields.js",
        "suggestions.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "clipboardWrite",
    "offscreen"
  ],
  "optional_permissions": [
    "privacy"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fill with Nuvori",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
