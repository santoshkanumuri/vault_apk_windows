{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuvori",
  "version": "2.2.1",
  "identifier": "com.nuvori.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Nuvori",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Your private vault on Windows",
    "longDescription": "A local-first Windows companion for the Nuvori vault.",
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}

